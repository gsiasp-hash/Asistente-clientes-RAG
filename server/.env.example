PORT=5000

# Groq Cloud Key (https://console.groq.com)
GROQ_API_KEY=tu_groq_api_key_aqui

# Google Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Supabase Credentials (https://supabase.com)
# OJO: solo el dominio raíz del proyecto, SIN /rest/v1
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu_supabase_service_role_key

# Modelos (configurables)
EMBEDDING_MODEL=gemini-embedding-001
LLM_MODEL=openai/gpt-oss-120b

# RAG: similitud mínima para considerar un chunk relevante (0 a 1)
RAG_MATCH_THRESHOLD=0.4

# Multi-tenant para portafolio público
ADMIN_TOKEN=un_token_secreto_para_subir_documentos_globales
SESSION_TTL_HOURS=1
DAILY_UPLOAD_LIMIT=50
SESSION_MESSAGE_LIMIT=15
