
# Groq Cloud Key (https://console.groq.com)
GROQ_API_KEY=tu_groq_api_key_aqui

# Google Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Supabase Credentials (https://supabase.com)
# OJO: solo el dominio raíz del proyecto, SIN /rest/v1
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu_supabase_service_role_key

# Modelos (configurables)
EMBEDDING_MODEL=gemini-embedding-001
LLM_MODEL=openai/gpt-oss-120b

# RAG: similitud mínima para considerar un chunk relevante (0 a 1)
RAG_MATCH_THRESHOLD=0.4

# Multi-tenant para portafolio público
ADMIN_TOKEN=un_token_secreto_para_subir_documentos_globales
SESSION_TTL_HOURS=1
SESSION_MAX_AGE_HOURS=24
DAILY_UPLOAD_LIMIT=50
SESSION_MESSAGE_LIMIT=15

# Blindaje anti-abuso del chat público
# Tope diario global de mensajes en TODAS las sesiones (freno económico)
GLOBAL_DAILY_MESSAGE_LIMIT=200
# Orígenes legítimos separados por coma (sin / final). Peticiones con Origin fuera de la lista → 403
ALLOWED_ORIGINS=https://tu-proyecto.vercel.app,http://localhost:3000

# Cloudflare Turnstile (opcional; si TURNSTILE_SECRET_KEY está vacío se omite la verificación)
# Widget: https://dash.cloudflare.com/?to=/:account/turnstile → dominios: localhost,127.0.0.1,y tu dominio de producción
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Hostnames válidos que devuelve siteverify (producción SIN localhost)
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
